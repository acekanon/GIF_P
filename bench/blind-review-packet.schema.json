{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gifp.local/schemas/blind-review-packet.schema.json",
  "title": "GIFP opaque blind-review packet manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_protocol",
    "vote_protocol",
    "packet_id",
    "entrypoint",
    "run_id",
    "corpus_id",
    "manifest_sha256",
    "source_git_commit",
    "source_git_dirty",
    "packager_git_commit",
    "packager_git_dirty",
    "expected_pair_count",
    "available_pair_count",
    "formal_pair_count",
    "asset_file_count",
    "source_report_sha256",
    "source_blind_page_sha256",
    "review_template_sha256"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_protocol": { "const": "gifp-blind-review-packet-v1" },
    "vote_protocol": { "const": "gifp-paired-blind-v2" },
    "packet_id": { "type": "string", "pattern": "^packet-[0-9]{2,}$" },
    "entrypoint": { "const": "OPEN-REVIEW.html" },
    "run_id": { "type": "string", "minLength": 1 },
    "corpus_id": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "source_git_commit": { "$ref": "#/$defs/gitCommit" },
    "source_git_dirty": { "type": "boolean" },
    "packager_git_commit": { "$ref": "#/$defs/gitCommit" },
    "packager_git_dirty": { "type": "boolean" },
    "expected_pair_count": { "type": "integer", "minimum": 1 },
    "available_pair_count": { "type": "integer", "minimum": 1 },
    "formal_pair_count": { "type": "integer", "minimum": 1 },
    "asset_file_count": { "type": "integer", "minimum": 2 },
    "source_report_sha256": { "$ref": "#/$defs/sha256" },
    "source_blind_page_sha256": { "$ref": "#/$defs/sha256" },
    "review_template_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" }
  }
}
