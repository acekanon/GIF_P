        "alpha_sample_height",
        "raw_vmaf_log_path",
        "vmaf_neg_mean",
        "vmaf_neg_p05",
        "vmaf_neg_min",
        "psnr_y_mean_db",
        "ssim_mean",
        "ssim_min",
        "ms_ssim_mean",
        "ms_ssim_min",
        "ms_ssim_valid_ratio",
        "ciede2000_mean",
        "ciede2000_p95",
        "ciede2000_valid_ratio",
        "cambi_mean",
        "cambi_p95",
        "mean_oklab_error",
        "static_region_oklab_error",
        "static_region_temporal_residual",
        "static_pixel_ratio",
        "edge_error",
        "edge_preservation",
        "edge_pixel_ratio",
        "alpha_mean_absolute_error",
        "alpha_coverage_error",
        "reference_loop_seam_oklab",
        "output_loop_seam_oklab",
        "loop_seam_excess_oklab"
      ],
      "properties": {
        "status": { "const": "full" },
        "analysis_fps": { "type": "integer", "minimum": 1 },
        "compared_frames": { "type": "integer", "minimum": 1 },
        "presentation_width": { "type": "integer", "minimum": 2 },
        "presentation_height": { "type": "integer", "minimum": 2 },
        "sample_width": { "type": "integer", "minimum": 1 },
        "sample_height": { "type": "integer", "minimum": 1 },
        "alpha_sample_width": { "type": "integer", "minimum": 1 },
        "alpha_sample_height": { "type": "integer", "minimum": 1 },
        "raw_vmaf_log_path": { "type": "string", "minLength": 1 },
        "vmaf_neg_mean": { "type": "number" },
        "vmaf_neg_p05": { "type": "number" },
        "vmaf_neg_min": { "type": "number" },
        "psnr_y_mean_db": { "$ref": "#/$defs/nullableFiniteNumber" },
        "ssim_mean": { "type": "number" },
        "ssim_min": { "type": "number" },
        "ms_ssim_mean": { "$ref": "#/$defs/nullableFiniteNumber" },
        "ms_ssim_min": { "$ref": "#/$defs/nullableFiniteNumber" },
        "ms_ssim_valid_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "ciede2000_mean": {
          "description": "Mean libvmaf ciede feature quality score; higher is better. This is not raw Delta E.",
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "ciede2000_p95": {
          "description": "P95 libvmaf ciede feature quality score; higher is better.",
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "ciede2000_valid_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "cambi_mean": { "type": "number", "minimum": 0 },
        "cambi_p95": { "type": "number", "minimum": 0 },
        "mean_oklab_error": { "type": "number", "minimum": 0 },
        "static_region_oklab_error": { "type": "number", "minimum": 0 },
        "static_region_temporal_residual": { "type": "number", "minimum": 0 },
        "static_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "edge_error": { "type": "number", "minimum": 0 },
        "edge_preservation": { "type": "number", "minimum": 0 },
        "edge_pixel_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
        "alpha_mean_absolute_error": { "type": "number", "minimum": 0, "maximum": 1 },
        "alpha_coverage_error": { "type": "number", "minimum": 0, "maximum": 1 },
        "reference_loop_seam_oklab": { "type": "number", "minimum": 0 },
        "output_loop_seam_oklab": { "type": "number", "minimum": 0 },
        "loop_seam_excess_oklab": { "type": "number", "minimum": 0 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_bytes",
        "frame_count",
        "duration_seconds",
        "encode_elapsed_ms",
        "encode_wall_elapsed_ms",
        "encode_memory",
        "metric_elapsed_ms",
        "total_wall_elapsed_ms",
        "objective"
      ],
      "properties": {
        "size_bytes": { "type": "integer", "minimum": 0 },
        "frame_count": { "type": "integer", "minimum": 0 },
        "duration_seconds": { "type": "number", "minimum": 0 },
        "encode_elapsed_ms": { "type": "integer", "minimum": 0 },
        "encode_wall_elapsed_ms": { "type": "integer", "minimum": 0 },
        "encode_memory": {
          "oneOf": [
            { "$ref": "#/$defs/processTreeMemory" },
            { "type": "null" }
          ]
        },
        "metric_elapsed_ms": { "type": "integer", "minimum": 0 },
        "total_wall_elapsed_ms": { "type": "integer", "minimum": 0 },
        "objective": {
          "oneOf": [
            { "$ref": "#/$defs/objectiveMetrics" },
            { "type": "null" }
          ]
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration_error_ms",
        "duration_passed",
        "frame_count_passed",
        "alpha_required",
        "alpha_coverage_tolerance",
        "alpha_passed",
        "seamless_loop_required",
        "seamless_loop_passed",
        "all_passed",
        "violations"
      ],
      "properties": {
        "duration_error_ms": { "type": "number", "minimum": 0 },
        "duration_passed": { "type": "boolean" },
        "frame_count_passed": { "type": "boolean" },
        "alpha_required": { "type": "boolean" },
        "alpha_coverage_tolerance": { "type": "number", "minimum": 0, "maximum": 1 },
        "alpha_passed": { "type": "boolean" },
        "seamless_loop_required": { "type": "boolean" },
        "seamless_loop_passed": { "type": "boolean" },
        "all_passed": { "type": "boolean" },
        "violations": { "type": "array", "items": { "type": "string" } }
      }
