      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "parent_pid": {
          "oneOf": [
            { "type": "integer", "minimum": 1 },
            { "type": "null" }
          ]
        },
        "name": { "type": "string", "minLength": 1 },
        "start_time_unix_seconds": { "type": "integer", "minimum": 0 },
        "rss_bytes": { "type": "integer", "minimum": 0 },
        "is_root": { "type": "boolean" }
      }
    },
    "processTreeMemory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sampler_id",
        "metric",
        "includes_root",
        "includes_descendants",
        "sample_interval_ms",
        "sample_count",
        "baseline_tree_rss_bytes",
        "peak_tree_rss_bytes",
        "peak_incremental_tree_rss_bytes",
        "max_process_count",
        "peak_processes"
      ],
      "properties": {
        "sampler_id": { "type": "string", "minLength": 1 },
        "metric": { "const": "summed_resident_set_bytes" },
        "includes_root": { "const": true },
        "includes_descendants": { "const": true },
        "sample_interval_ms": { "type": "integer", "minimum": 1 },
        "sample_count": { "type": "integer", "minimum": 1 },
        "baseline_tree_rss_bytes": { "type": "integer", "minimum": 0 },
        "peak_tree_rss_bytes": { "type": "integer", "minimum": 0 },
        "peak_incremental_tree_rss_bytes": { "type": "integer", "minimum": 0 },
        "max_process_count": { "type": "integer", "minimum": 1 },
        "peak_processes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/processMemoryBreakdown" }
        }
      }
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec",
        "width",
        "height",
        "duration",
        "frame_count",
        "animated",
        "has_alpha"
      ],
      "properties": {
        "codec": { "type": "string" },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 },
        "duration": { "type": "number", "minimum": 0 },
        "frame_count": { "type": "integer", "minimum": 0 },
        "animated": { "type": "boolean" },
        "has_alpha": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "category",
        "tags",
        "path",
        "sha256",
        "expected_source_sha256",
        "canonical_identity_passed",
        "inspection"
      ],
      "properties": {
        "fixture_id": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "tags": { "type": "array", "items": { "type": "string" } },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "expected_source_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "canonical_identity_passed": { "type": "boolean" },
        "inspection": { "$ref": "#/$defs/inspection" }
      }
