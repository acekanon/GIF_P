    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_id",
        "profile_id",
        "status",
        "source_sha256",
        "request_sha256",
        "request",
        "output_sha256",
        "metrics",
        "correctness",
        "output_inspection",
        "result",
        "error"
      ],
      "properties": {
        "fixture_id": { "type": "string", "minLength": 1 },
        "profile_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["ok", "gate_failed", "error"] },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "request_sha256": { "$ref": "#/$defs/sha256" },
        "request": { "type": "object" },
        "output_sha256": {
          "oneOf": [
            { "$ref": "#/$defs/sha256" },
            { "type": "null" }
          ]
        },
        "metrics": {
          "oneOf": [
            { "$ref": "#/$defs/metrics" },
            { "type": "null" }
          ]
        },
        "correctness": {
          "oneOf": [
            { "$ref": "#/$defs/correctness" },
            { "type": "null" }
          ]
        },
        "output_inspection": {
          "oneOf": [
            { "$ref": "#/$defs/inspection" },
            { "type": "null" }
          ]
        },
        "result": {
          "oneOf": [
            { "type": "object" },
            { "type": "null" }
          ]
        },
        "error": { "$ref": "#/$defs/nullableString" }
      }
    }
  }
}
