{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gifp.local/schemas/blind-review-distribution.schema.json",
  "title": "GIFP blind-review coordinator distribution",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_protocol",
    "run_id",
    "quality_report_path",
    "quality_report_sha256",
    "source_git_commit",
    "packager_git_commit",
    "reviewer_count",
    "packets"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "packet_protocol": { "const": "gifp-blind-review-packet-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "quality_report_path": { "type": "string", "minLength": 1 },
    "quality_report_sha256": { "$ref": "#/$defs/sha256" },
    "source_git_commit": { "$ref": "#/$defs/gitCommit" },
    "packager_git_commit": { "$ref": "#/$defs/gitCommit" },
    "reviewer_count": { "type": "integer", "minimum": 3 },
    "packets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/packet" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "nullableSha256": {
      "anyOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "run_id",
        "reference_profile_id",
        "candidate_profile_id",
        "formal_pair_count",
        "packet_directory",
        "packet_directory_checksum_manifest_sha256",
        "checksummed_file_count",
        "archive_name",
        "archive_size_bytes",
        "archive_sha256"
      ],
      "properties": {
        "packet_id": { "type": "string", "pattern": "^packet-[0-9]{2,}$" },
        "run_id": { "type": "string", "minLength": 1 },
        "reference_profile_id": { "type": "string", "minLength": 1 },
        "candidate_profile_id": { "type": "string", "minLength": 1 },
        "formal_pair_count": { "type": "integer", "minimum": 1 },
        "packet_directory": { "type": "string", "minLength": 1 },
        "packet_directory_checksum_manifest_sha256": { "$ref": "#/$defs/sha256" },
        "checksummed_file_count": { "type": "integer", "minimum": 4 },
        "archive_name": { "type": ["string", "null"] },
        "archive_size_bytes": { "type": ["integer", "null"], "minimum": 1 },
        "archive_sha256": { "$ref": "#/$defs/nullableSha256" }
      }
    }
  }
}
