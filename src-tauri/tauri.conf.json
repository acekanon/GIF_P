{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GIFP 6.1.0",
  "version": "6.1.0",
  "identifier": "com.acekanon.gifp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "GIFP 6.1.0 · 内部体验版",
        "width": 1440,
        "height": 1024,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/icon.ico"]
  }
}
